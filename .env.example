# PostgreSQL connection string, e.g.:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Vercel (serverless, connection pooling), append ?connection_limit=1 :
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=1
DATABASE_URL=

# Single admin username (never commit the real value)
ADMIN_USERNAME=

# bcrypt hash of the admin password.
# Generate with:  bun scripts/hash-password.cjs   (or:  node scripts/hash-password.cjs)
# NEVER put the plain password here.
#
# IMPORTANT (local dev / build only): Next.js/Turbopack expands `$` in .env files
# (the value is parsed more than once), so a raw bcrypt hash like $2b$12$... gets
# mangled. Escaping each `$` as \\$ makes it work correctly in .env.local, e.g.:
#   ADMIN_PASSWORD_HASH=\\$2b\\$12\\$<replace-with-your-hash-without-escapes>
# In the Vercel dashboard, paste the RAW hash (no escaping) - Vercel does not parse
# .env files; values are injected directly.
ADMIN_PASSWORD_HASH=

# Secret used to sign/encrypt session cookies. Must be at least 32 characters.
# Generate with:  openssl rand -base64 48
# (or:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
SESSION_SECRET=